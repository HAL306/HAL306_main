#pragma kernel CSGenerateBaseTerrainDots

struct BaseDotInstance
{
    float3 worldPosition;
    float4 color;
    float2 uv;
    float3 worldNormal;
    float edgeDistance; // 外側エッジまでの最短距離
};

StructuredBuffer<float2> _Vertices;
StructuredBuffer<int> _Triangles;
StructuredBuffer<float2> _UVs;
StructuredBuffer<float4> _BoundaryEdges;
AppendStructuredBuffer<BaseDotInstance> _ResultDots;

float2 _GridOffset;
float2 _GridSpacing;
float _EdgeNormalWidth;
int _TriangleCount;
int _EdgeCount;
uint2 _GridDimensions;

bool PointInTriangle(float2 pt, float2 v1, float2 v2, float2 v3)
{
    float d1 = (pt.x - v2.x) * (v1.y - v2.y) - (v1.x - v2.x) * (pt.y - v2.y);
    float d2 = (pt.x - v3.x) * (v2.y - v3.y) - (v2.x - v3.x) * (pt.y - v3.y);
    float d3 = (pt.x - v1.x) * (v3.y - v1.y) - (v3.x - v1.x) * (pt.y - v1.y);
    return !(((d1 < 0) || (d2 < 0) || (d3 < 0)) && ((d1 > 0) || (d2 > 0) || (d3 > 0)));
}

float DistanceToSegment(float2 p, float2 a, float2 b, out float2 outNormal)
{
    float2 ab = b - a;
    float2 ap = p - a;
    float t = saturate(dot(ap, ab) / (dot(ab, ab) + 1e-6));
    float2 closest = a + t * ab;
    
    // 線分に対して垂直なベクトル
    float2 n = float2(-ab.y, ab.x);
    float len = length(n);
    outNormal = len > 1e-6 ? n / len : float2(0, 0);
    return distance(p, closest);
}

[numthreads(8, 8, 1)]
void CSGenerateBaseTerrainDots(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _GridDimensions.x || id.y >= _GridDimensions.y) return;

    float2 worldPos2D = _GridOffset + float2(id.x, id.y) * _GridSpacing;

    // MeshDotRenderer と同様、4近傍の位置をサンプリング
    float2 posC = worldPos2D;
    float2 posL = worldPos2D + float2(-_GridSpacing.x, 0);
    float2 posR = worldPos2D + float2( _GridSpacing.x, 0);
    float2 posD = worldPos2D + float2(0, -_GridSpacing.y);
    float2 posU = worldPos2D + float2(0,  _GridSpacing.y);

    bool insideC = false, insideL = false, insideR = false, insideD = false, insideU = false;
    float padding = max(_GridSpacing.x, _GridSpacing.y);
    int matchTriangle = -1;

    for (int t = 0; t < _TriangleCount; t++)
    {
        int tBase = t * 3;
        float2 vA = _Vertices[_Triangles[tBase + 0]];
        float2 vB = _Vertices[_Triangles[tBase + 1]];
        float2 vC = _Vertices[_Triangles[tBase + 2]];

        float minX = min(vA.x, min(vB.x, vC.x)) - padding;
        float maxX = max(vA.x, max(vB.x, vC.x)) + padding;
        float minY = min(vA.y, min(vB.y, vC.y)) - padding;
        float maxY = max(vA.y, max(vB.y, vC.y)) + padding;

        if (posC.x < minX || posC.x > maxX || posC.y < minY || posC.y > maxY)
            continue;

        if (!insideC)
        {
            if (PointInTriangle(posC, vA, vB, vC))
            {
                insideC = true;
                matchTriangle = t;
            }
        }
        if (!insideL) insideL = PointInTriangle(posL, vA, vB, vC);
        if (!insideR) insideR = PointInTriangle(posR, vA, vB, vC);
        if (!insideD) insideD = PointInTriangle(posD, vA, vB, vC);
        if (!insideU) insideU = PointInTriangle(posU, vA, vB, vC);
    }

    if (insideC && matchTriangle >= 0)
    {
        // 全エッジから最短距離と線分法線を探索
        float minEdgeDist = 999999.0;
        float2 bestEdgeNormal2D = float2(0, 0);

        for (int e = 0; e < _EdgeCount; e++)
        {
            float4 edge = _BoundaryEdges[e];

            float minX = min(edge.x, edge.z) - minEdgeDist;
            float maxX = max(edge.x, edge.z) + minEdgeDist;
            float minY = min(edge.y, edge.w) - minEdgeDist;
            float maxY = max(edge.y, edge.w) + minEdgeDist;

            if (posC.x < minX || posC.x > maxX || posC.y < minY || posC.y > maxY)
                continue;

            float2 n;
            float d = DistanceToSegment(posC, edge.xy, edge.zw, n);
            if (d < minEdgeDist)
            {
                minEdgeDist = d;
                bestEdgeNormal2D = n;
            }
        }

        // デフォルトは正面向き法線 (Z = -1)
        float3 worldNormal = float3(0, 0, -1);

        // _EdgeNormalWidth が 0 より大きい場合、エッジ法線を計算
        if (_EdgeNormalWidth > 0.0001 && minEdgeDist <= _EdgeNormalWidth)
        {
            // 【MeshDotRendererと完全同一の外向きベクトル算出】
            float2 roughEdgeVec = float2(0, 0);
            if (!insideL) roughEdgeVec.x -= 1.0;
            if (!insideR) roughEdgeVec.x += 1.0;
            if (!insideD) roughEdgeVec.y -= 1.0;
            if (!insideU) roughEdgeVec.y += 1.0;

            // 輪郭直近でなくても、エッジまでの方向ベクトルから外向きを安全に補完
            if (length(roughEdgeVec) < 0.1)
            {
                // (closestPoint - ドット位置) ＝ エッジ（外側）へ向かう真の外向きベクトル
                for (int e2 = 0; e2 < _EdgeCount; e2++)
                {
                    float4 edge2 = _BoundaryEdges[e2];
                    float2 ab = edge2.zw - edge2.xy;
                    float2 ap = posC - edge2.xy;
                    float t = saturate(dot(ap, ab) / (dot(ab, ab) + 1e-6));
                    float2 closest = edge2.xy + t * ab;
                    if (distance(posC, closest) <= minEdgeDist + 1e-4)
                    {
                        roughEdgeVec = closest - posC; // ★内側から外側境界への向き
                        break;
                    }
                }
            }

            // 内積判定：外向きベクトル(roughEdgeVec)と法線が逆を向いていたら必ず反転
            if (dot(bestEdgeNormal2D, roughEdgeVec) < 0.0)
            {
                bestEdgeNormal2D = -bestEdgeNormal2D;
            }

            // エッジからの距離に応じた減衰（指定幅の境界で0、外周端で1）
            float edgeFactor = 1.0 - saturate(minEdgeDist / _EdgeNormalWidth);

            // MeshDotRenderer と全く同じ係数 (0.75, -0.66) で傾ける
            worldNormal = normalize(float3(bestEdgeNormal2D * edgeFactor * 0.75, -0.66));
        }

        int tBase = matchTriangle * 3;
        int i0 = _Triangles[tBase + 0];
        int i1 = _Triangles[tBase + 1];
        int i2 = _Triangles[tBase + 2];

        float2 a = _Vertices[i0];
        float2 b = _Vertices[i1];
        float2 c = _Vertices[i2];

        float den = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
        float2 uv = worldPos2D;

        if (abs(den) > 0.00001)
        {
            float w1 = ((b.y - c.y) * (worldPos2D.x - c.x) + (c.x - b.x) * (worldPos2D.y - c.y)) / den;
            float w2 = ((c.y - a.y) * (worldPos2D.x - c.x) + (a.x - c.x) * (worldPos2D.y - c.y)) / den;
            float w3 = 1.0 - w1 - w2;
            uv = w1 * _UVs[i0] + w2 * _UVs[i1] + w3 * _UVs[i2];
        }

        BaseDotInstance dotInst;
        dotInst.worldPosition = float3(worldPos2D.x, worldPos2D.y, 0.0);
        dotInst.color = float4(1, 1, 1, 1);
        dotInst.uv = uv;
        dotInst.worldNormal = worldNormal;
        dotInst.edgeDistance = minEdgeDist;

        _ResultDots.Append(dotInst);
    }
}